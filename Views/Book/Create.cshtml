@model Book
@{
    ViewData["Title"] = "Thêm sách";
}
<h1>Thêm sách</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="editor">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit">Lưu sách</button>
        <a class="button secondary" asp-action="Index">Về danh sách</a>
    </div>
</form>
